{
  "expo": {
    "name": "Rotina do Lar",
    "slug": "rotina-lar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rotina-icon.png",
    "scheme": "rotinalar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/rotina-icon.png"
    },
    "android": {
      "package": "com.rotinalar.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rotina-adaptive-foreground.png",
        "monochromeImage": "./assets/images/rotina-monochrome.png",
        "backgroundColor": "#A65B73"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rotina-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F2"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f0b2a28e-9fa6-4a94-a49d-61e1cde67711"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f0b2a28e-9fa6-4a94-a49d-61e1cde67711"
    }
  }
}
